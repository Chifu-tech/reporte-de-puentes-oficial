# URL pública del sitio (sin slash final). Usada para canonical, sitemap y OG.
NEXT_PUBLIC_SITE_URL=https://reportedepuentesoficial.mx

# ── Base de datos (Turso) ─────────────────────────────────────────
# En desarrollo puedes dejar ambas variables vacías: se usará un
# archivo local (local.db) con los mismos esquemas.
# En producción (Vercel): crea la BD en https://turso.tech y copia los valores.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Cron de captura histórica ─────────────────────────────────────
# Secreto compartido entre GitHub Actions y Vercel para proteger
# /api/cron/snapshot. Genera uno con: openssl rand -hex 24
# En desarrollo se puede dejar vacío (el endpoint queda abierto solo en local).
CRON_SECRET=

# ── AdSense (fase de monetización — dejar apagado hasta tener tráfico) ──
# NEXT_PUBLIC_ADS_ENABLED=true activa los anuncios en los espacios ya diseñados.
# NEXT_PUBLIC_ADSENSE_CLIENT es el ID ca-pub-XXXX de tu cuenta de AdSense.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
